# GrepGoods Environment Variables

# The domain name where the service is hosted (crucial for ActivityPub)
# Example: grepgoods.example.com
DOMAIN=grepgoods.your-domain.tld

# Port the Express server will listen on
PORT=3000

# Path to the SQLite database file
DATABASE_PATH=./data/grepgoods.db

# Ollama API host for local AI processing
OLLAMA_HOST=http://localhost:11434

# Redis configuration for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Environment mode (development, production, test)
NODE_ENV=development
